{
  "name": "macro-terminal",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted macro and portfolio terminal with a source-checked AI agent. Works with a local LLM or an external API.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev -H 127.0.0.1 -p 4810",
    "build": "next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start -H 127.0.0.1 -p 4810",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup:yfinance": "python3 -m venv .venv && .venv/bin/python -m pip install -q yfinance",
    "llm:local": "sh scripts/start-local-llm.sh",
    "lang:add": "node scripts/add-language.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "d3-geo": "^3.1.1",
    "i18n-iso-countries": "^7.14.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
